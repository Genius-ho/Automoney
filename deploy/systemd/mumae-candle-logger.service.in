[Unit]
Description=Mumae 1-minute candle history logger (oneshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ho
Group=ho
WorkingDirectory=@MUMAE_PROJECT_ROOT@
EnvironmentFile=@MUMAE_PROJECT_ROOT@/deploy/mumae.env
ExecStart=/usr/bin/python3 @MUMAE_PROJECT_ROOT@/candle_logger.py KORU SOXL TQQQ
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@MUMAE_PROJECT_ROOT@/data
