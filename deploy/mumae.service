[Unit]
Description=Mumae headless CLI trading engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ho
Group=ho
WorkingDirectory=/home/ho/apps/automoney
EnvironmentFile=/home/ho/apps/automoney/deploy/mumae.env
ExecStart=/usr/bin/python3 /home/ho/apps/automoney/mumae_cli.py serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ho/apps/automoney/data

[Install]
WantedBy=multi-user.target
