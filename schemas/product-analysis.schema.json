{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutomoneyProductAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "material",
    "dimensions",
    "colors",
    "components",
    "manufacturer",
    "countryOfOrigin",
    "handlingPrecautions",
    "searchTags",
    "coupangTitleCandidate",
    "unresolvedFields"
  ],
  "properties": {
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "evidence"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidenceItem" } }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "evidence"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidenceItem" } }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "confidence", "evidence"],
      "properties": {
        "values": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidenceItem" } }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "confidence", "evidence"],
      "properties": {
        "values": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidenceItem" } }
      }
    },
    "manufacturer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "evidence"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidenceItem" } }
      }
    },
    "countryOfOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "evidence"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidenceItem" } }
      }
    },
    "handlingPrecautions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "evidence"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidenceItem" } }
      }
    },
    "searchTags": { "type": "array", "items": { "type": "string" } },
    "coupangTitleCandidate": { "type": ["string", "null"] },
    "unresolvedFields": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFile", "sliceIndex", "quote", "rawJsonPath"],
      "properties": {
        "sourceFile": { "type": ["string", "null"] },
        "sliceIndex": { "type": ["integer", "null"] },
        "quote": { "type": ["string", "null"] },
        "rawJsonPath": { "type": ["string", "null"] }
      }
    }
  }
}
